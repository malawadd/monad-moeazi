{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moeazi.test/schemas/manifest.autonomy.testnet.json",
  "title": "Moeazi Monad Testnet Autonomy Deployment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "network", "chainId", "deploymentStatus", "verified",
    "enrollmentEnabled", "addresses", "codeHashes", "seed", "source", "deploymentTxHashes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "network": { "const": "monad-testnet" },
    "chainId": { "const": 10143 },
    "deploymentStatus": { "enum": ["verified", "superseded"] },
    "verified": { "const": true },
    "enrollmentEnabled": { "const": false },
    "addresses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["administrator", "executor", "usdc", "factory", "tokens"],
      "properties": {
        "administrator": { "$ref": "#/$defs/address" },
        "executor": { "$ref": "#/$defs/address" },
        "usdc": { "const": "0x534b2f3A21130d7a60830c2Df862319e593943A3" },
        "factory": { "$ref": "#/$defs/address" },
        "tokens": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "$ref": "#/$defs/tokenPoolMZA" },
            { "$ref": "#/$defs/tokenPoolMZB" },
            { "$ref": "#/$defs/tokenPoolMZG" }
          ],
          "items": false
        }
      }
    },
    "codeHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factory", "tokens", "pools"],
      "properties": {
        "factory": { "$ref": "#/$defs/hash" },
        "tokens": { "$ref": "#/$defs/hashList" },
        "pools": { "$ref": "#/$defs/hashList" }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usdcPerPool", "tokensPerPool"],
      "properties": {
        "usdcPerPool": { "const": "6000000" },
        "tokensPerPool": { "const": "6000000000000000000000" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "solc", "foundry", "foundryTomlHash"],
      "properties": {
        "revision": { "type": "string", "minLength": 7 },
        "solc": { "const": "0.8.26" },
        "foundry": { "const": "v1.8.4" },
        "foundryTomlHash": { "$ref": "#/$defs/hash" }
      }
    },
    "deploymentTxHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items"],
      "properties": {
        "status": { "const": "verified" },
        "items": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/receipt" },
          "allOf": [
            { "contains": { "properties": { "label": { "const": "deploy_token_MZA" } }, "required": ["label"] } },
            { "contains": { "properties": { "label": { "const": "deploy_token_MZB" } }, "required": ["label"] } },
            { "contains": { "properties": { "label": { "const": "deploy_token_MZG" } }, "required": ["label"] } },
            { "contains": { "properties": { "label": { "const": "deploy_pool_MZA" } }, "required": ["label"] } },
            { "contains": { "properties": { "label": { "const": "deploy_pool_MZB" } }, "required": ["label"] } },
            { "contains": { "properties": { "label": { "const": "deploy_pool_MZG" } }, "required": ["label"] } },
            { "contains": { "properties": { "label": { "const": "seed_MZA" } }, "required": ["label"] } },
            { "contains": { "properties": { "label": { "const": "seed_MZB" } }, "required": ["label"] } },
            { "contains": { "properties": { "label": { "const": "seed_MZG" } }, "required": ["label"] } },
            { "contains": { "properties": { "label": { "const": "approve_USDC_MZA" } }, "required": ["label"] } },
            { "contains": { "properties": { "label": { "const": "approve_token_MZA" } }, "required": ["label"] } },
            { "contains": { "properties": { "label": { "const": "approve_USDC_MZB" } }, "required": ["label"] } },
            { "contains": { "properties": { "label": { "const": "approve_token_MZB" } }, "required": ["label"] } },
            { "contains": { "properties": { "label": { "const": "approve_USDC_MZG" } }, "required": ["label"] } },
            { "contains": { "properties": { "label": { "const": "approve_token_MZG" } }, "required": ["label"] } },
            { "contains": { "properties": { "label": { "const": "deploy_factory" } }, "required": ["label"] } }
          ]
        }
      }
    },
    "supersessionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "oldFactoryEnrollmentEnabled", "recoveryReceipts", "oldPoolReservesAfterRecovery"],
      "properties": {
        "reason": { "const": "Superseded because the prior pool implementation allowed owner liquidity withdrawal." },
        "oldFactoryEnrollmentEnabled": { "const": false },
        "supersededByFactory": { "$ref": "#/$defs/address" },
        "recoveryReceipts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "$ref": "#/$defs/recoveryMZA" },
            { "$ref": "#/$defs/recoveryMZB" },
            { "$ref": "#/$defs/recoveryMZG" }
          ],
          "items": false
        },
        "oldPoolReservesAfterRecovery": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "$ref": "#/$defs/emptyMZA" },
            { "$ref": "#/$defs/emptyMZB" },
            { "$ref": "#/$defs/emptyMZG" }
          ],
          "items": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "deploymentStatus": { "const": "superseded" } }, "required": ["deploymentStatus"] },
      "then": { "required": ["supersessionEvidence"] }
    }
  ],
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "hashList": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/hash" }
    },
    "tokenPoolBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name", "symbol", "address", "pool"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 2 },
        "name": { "type": "string" },
        "symbol": { "enum": ["MZA", "MZB", "MZG"] },
        "address": { "$ref": "#/$defs/address" },
        "pool": { "$ref": "#/$defs/address" }
      }
    },
    "tokenPoolMZA": {
      "allOf": [
        { "$ref": "#/$defs/tokenPoolBase" },
        { "properties": { "index": { "const": 0 }, "symbol": { "const": "MZA" } } }
      ]
    },
    "tokenPoolMZB": {
      "allOf": [
        { "$ref": "#/$defs/tokenPoolBase" },
        { "properties": { "index": { "const": 1 }, "symbol": { "const": "MZB" } } }
      ]
    },
    "tokenPoolMZG": {
      "allOf": [
        { "$ref": "#/$defs/tokenPoolBase" },
        { "properties": { "index": { "const": 2 }, "symbol": { "const": "MZG" } } }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "txHash", "blockNumber", "status"],
      "properties": {
        "label": {
          "enum": [
            "deploy_token_MZA", "deploy_token_MZB", "deploy_token_MZG",
            "deploy_pool_MZA", "deploy_pool_MZB", "deploy_pool_MZG",
            "seed_MZA", "seed_MZB", "seed_MZG",
            "approve_USDC_MZA", "approve_token_MZA", "approve_USDC_MZB",
            "approve_token_MZB", "approve_USDC_MZG", "approve_token_MZG", "deploy_factory"
          ]
        },
        "txHash": { "$ref": "#/$defs/hash" },
        "blockNumber": { "type": "integer", "minimum": 0 },
        "status": { "const": 1 }
      }
    },
    "recoveryBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "pool", "txHash", "blockNumber", "status"],
      "properties": {
        "symbol": { "enum": ["MZA", "MZB", "MZG"] },
        "pool": { "$ref": "#/$defs/address" },
        "txHash": { "$ref": "#/$defs/hash" },
        "blockNumber": { "type": "integer", "minimum": 0 },
        "status": { "const": 1 }
      }
    },
    "recoveryMZA": {
      "allOf": [
        { "$ref": "#/$defs/recoveryBase" },
        { "properties": { "symbol": { "const": "MZA" } } }
      ]
    },
    "recoveryMZB": {
      "allOf": [
        { "$ref": "#/$defs/recoveryBase" },
        { "properties": { "symbol": { "const": "MZB" } } }
      ]
    },
    "recoveryMZG": {
      "allOf": [
        { "$ref": "#/$defs/recoveryBase" },
        { "properties": { "symbol": { "const": "MZG" } } }
      ]
    },
    "emptyPoolBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "usdcReserve", "tokenReserve"],
      "properties": {
        "symbol": { "enum": ["MZA", "MZB", "MZG"] },
        "usdcReserve": { "const": "0" },
        "tokenReserve": { "const": "0" }
      }
    },
    "emptyMZA": { "allOf": [{ "$ref": "#/$defs/emptyPoolBase" }, { "properties": { "symbol": { "const": "MZA" } } }] },
    "emptyMZB": { "allOf": [{ "$ref": "#/$defs/emptyPoolBase" }, { "properties": { "symbol": { "const": "MZB" } } }] },
    "emptyMZG": { "allOf": [{ "$ref": "#/$defs/emptyPoolBase" }, { "properties": { "symbol": { "const": "MZG" } } }] }
  }
}
