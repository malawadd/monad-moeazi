# Copy to ignored server environment; NEVER to Android or Next public configuration.
# Nothing is enabled by this example. Do not populate/enable paid services without approval.
MOBILE_PURCHASES_ENABLED=false
# Quote APIs may be metered; enable only after specific approval.
MOBILE_FUNDING_QUOTES_ENABLED=false
# Quote-capable versions: transak@2 (sandbox), transak@3 (production), moonpay@2, banxa@2. Keep old versions for pending operations.
MOBILE_FUNDING_PROVIDERS=
MOBILE_FIAT_CURRENCIES=USD,EUR,GBP
MOBILE_PUBLIC_RETURN_ORIGIN=
CONVEX_SITE_URL=
WORKER_SHARED_SECRET=
AGENT_SERVICE_URL=http://agent-service:8100
ARBITRUM_RPC_URL=
REDIS_URL=redis://redis:6379/0
PROVIDER_TOKEN_CACHE_SECRET=

# Scoped Uniswap signer and idempotency records use independent AES-GCM keys.
# Leave unset until Redis AOF fsync=always, local+replica WAITAOF, and persistent
# backing storage have been operationally verified. The exact acknowledgement is:
# SCOPED_SWAP_STORAGE_DURABILITY_ACK=redis-aof-fsync-always-one-durable-replica-v1
SCOPED_SWAP_SIGNER_VAULT_SECRET=
SCOPED_SWAP_OPERATION_STORE_SECRET=
SCOPED_SWAP_STORAGE_DURABILITY_ACK=

TRANSAK_SANDBOX=true
TRANSAK_API_KEY=
TRANSAK_API_SECRET=
TRANSAK_API_KEY_PR=
TRANSAK_API_SECRET_PR=
TRANSAK_REFERRER_DOMAIN=
MOBILE_TRANSAK_USDC_CONTRACT=
MOONPAY_SANDBOX=true
MOONPAY_API_KEY=
MOONPAY_API_SECRET=
MOONPAY_WEBHOOK_SECRET=
MOONPAY_ARBITRUM_USDC_CODE=
MOBILE_MOONPAY_USDC_CONTRACT=
BANXA_SANDBOX=true
BANXA_PARTNER_REF=
BANXA_API_KEY=
BANXA_WEBHOOK_KEY=
BANXA_WEBHOOK_SECRET=
BANXA_ARBITRUM_CODE=
BANXA_CHECKOUT_HOSTS=
MOBILE_BANXA_USDC_CONTRACT=

MOBILE_SPONSORSHIP_ENABLED=false
MOBILE_SPONSORSHIP_CERTIFIED=false
MOBILE_ACCOUNT_ADAPTER=kernel-033@0.3.3
MOBILE_BUNDLER=pimlico@1
MOBILE_PAYMASTER=pimlico@1
PIMLICO_API_KEY=
PIMLICO_SPONSORSHIP_POLICY_ID=
MOBILE_KERNEL_CODE_HASH=
MOBILE_ENTRY_POINT_CODE_HASH=
MOBILE_GAS_OPERATION_LIMIT_WEI=
MOBILE_GAS_ACCOUNT_LIMIT_WEI=
MOBILE_GAS_GLOBAL_LIMIT_WEI=

# Next SERVER environment, NOT provider credentials:
# EXECUTION_SIDECAR_URL=http://execution-sidecar:8300
# WORKER_SHARED_SECRET=<same internal secret>
# MOBILE_TRUSTED_CLIENT_IP_HEADER=<header overwritten by a trusted ingress>
# MOBILE_TRUSTED_CLIENT_IP_HOST=<public tunnel hostname; origin must remain private>
