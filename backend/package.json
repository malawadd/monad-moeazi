{
  "name": "moeazi-monad-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:convex",
    "dev:api": "tsx watch api-server/src/server.ts",
    "dev:convex": "convex dev",
    "api:build": "tsc --noEmit",
    "api:start": "node --import tsx api-server/src/server.ts",
    "api:parity": "node tests/api-route-parity-smoke.mjs",
    "mobile:magic-cleanup": "node scripts/cleanup-magic-mobile-users.mjs",
    "strategies:backfill": "node --env-file=.env.local --import tsx scripts/backfill-strategy-identities.ts",
    "stack:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-monad-stack.ps1",
    "stack:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-monad-stack.ps1",
    "build": "tsc --noEmit",
    "start": "npm run api:start",
    "lint": "eslint operator-console-lite scripts --ext .js,.mjs",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "feature-registry:generate": "node scripts/check-feature-registry.mjs --write",
    "feature-registry:check": "node scripts/check-feature-registry.mjs",
    "evidence-sinks:check": "node scripts/check-evidence-sink-inventory.mjs",
    "evidence-event-boundary:check": "node scripts/check-evidence-event-boundary.mjs",
    "schedule-sync-boundary:check": "node scripts/check-schedule-sync-boundary.mjs",
    "system-safety-assurance:check": "node scripts/check-system-safety-assurance-corpus.mjs",
    "claim-disagreement-ledger:check": "node scripts/check-claim-disagreement-ledger.mjs",
    "source-value-attribution:check": "node scripts/check-source-value-boundary.mjs",
    "evidence-integrity:check": "node scripts/check-evidence-integrity-boundary.mjs",
    "portfolio-sizing:check": "node scripts/check-portfolio-sizing-boundary.mjs",
    "execution-quality-routing:check": "node scripts/check-execution-quality-routing-boundary.mjs",
    "shadow-tca:check": "node scripts/check-shadow-tca-boundary.mjs",
    "decision-memory:check": "node scripts/check-decision-memory-boundary.mjs",
    "promotion:check": "node scripts/check-promotion-boundary.mjs",
    "selective-prediction:check": "node scripts/check-selective-prediction-boundary.mjs",
    "analytical-diversity:check": "node scripts/check-analytical-diversity-boundary.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@particle-network/universal-account-sdk": "2.0.0-beta.3",
    "buffer": "^6.0.3",
    "convex": "^1.23.0",
    "ethers": "^6.15.0",
    "hono": "^4.13.13",
    "jose": "^6.2.3",
    "msgpackr": "^1.11.5",
    "pg": "^8.23.1",
    "tsx": "^4.20.6",
    "viem": "^2.54.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "eslint": "^9",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "typescript": "^5"
  }
}
