{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moeazi.app/schemas/mobile/2026-09-01/home.schema.json",
  "title": "MobileHomeSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "totalBalanceUsd", "managedBalanceUsd", "availableCredits", "aiState", "primaryAction", "statusMessage"],
  "properties": {
    "schemaVersion": {"const": "2026-09-01"},
    "totalBalanceUsd": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
    "managedBalanceUsd": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
    "availableCredits": {"type": "number", "minimum": 0},
    "aiState": {"enum": ["needs_funds", "needs_credits", "ready", "starting", "running", "paused", "blocked", "emergency_stopped"]},
    "primaryAction": {"enum": ["deposit", "buy_credits", "start", "stop", "fix_issue", "review_safety"]},
    "statusMessage": {"type": "string", "minLength": 1},
    "assignmentState": {"enum": ["unassigned", "paused", "active", "ambiguous_assignment", "invalid_assignment"]},
    "assignmentId": {"type": ["string", "null"]},
    "programVersionId": {"type": ["string", "null"]},
    "controllerRef": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["schemaVersion", "environment", "strategyAccountId", "controllerKind", "controllerId", "controllerVersionId", "contentHash"],
      "properties": {
        "schemaVersion": {"const": 1}, "environment": {"const": "live"},
        "strategyAccountId": {"type": "string"}, "controllerKind": {"const": "managed_program"},
        "controllerId": {"type": "string"}, "controllerVersionId": {"type": "string"},
        "contentHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "blockingReason": {"type": "string", "minLength": 1},
    "staleAt": {"type": "string", "format": "date-time"},
    "latestAiUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "summary", "occurredAt"],
      "properties": {
        "state": {"enum": ["checking", "hold", "acted", "blocked"]},
        "summary": {"type": "string", "minLength": 1},
        "occurredAt": {"type": "string", "format": "date-time"},
        "activityId": {"type": "string", "minLength": 1}
      }
    }
  }
}
